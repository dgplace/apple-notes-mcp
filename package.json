{
  "name": "@simantaturja/apple-notes-mcp",
  "version": "2.0.0",
  "description": "MCP server for Apple Notes (macOS, via JXA/osascript)",
  "type": "module",
  "license": "MIT",
  "author": "Simanta Deb Turja",
  "homepage": "https://github.com/simantaturja/apple-notes-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simantaturja/apple-notes-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/simantaturja/apple-notes-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-notes",
    "notes",
    "macos",
    "jxa",
    "osascript",
    "claude"
  ],
  "bin": {
    "apple-notes-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/check-dependency-engines.mjs",
    "README.md",
    "DEPENDENCY_AUDIT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --import tsx --test test/*.test.ts",
    "check:dependency-engines": "node scripts/check-dependency-engines.mjs",
    "test:integration": "npm run build && APPLE_NOTES_IT=1 APPLE_NOTES_MODE=read-write node --import tsx --test test/integration.test.ts"
  },
  "engines": {
    "node": ">=18.14.1"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.20",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  }
}
